{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário no ecossistema Gama (Admin, Fonoaudióloga ou Cuidador/Familiar)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "fonoaudiologo", "cuidador", "responsavel"] },
        "phone": { "type": "string", "maxLength": 30 },
        "crfa": { "type": "string", "maxLength": 50 },
        "linkedPatientId": { "type": "string", "maxLength": 128 },
        "hasSetFirstPassword": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "createdAt"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Ficha do Paciente em Reabilitação da Deglutição",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "birthDate": { "type": "string", "maxLength": 20 },
        "mainDiagnosis": { "type": "string", "maxLength": 256 },
        "guardianName": { "type": "string", "maxLength": 150 },
        "guardianPhone": { "type": "string", "maxLength": 30 },
        "guardianEmail": { "type": "string", "maxLength": 256 },
        "caregiverName": { "type": "string", "maxLength": 150 },
        "caregiverPhone": { "type": "string", "maxLength": 30 },
        "caregiverEmail": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "ClinicalEvolution": {
      "title": "ClinicalEvolution",
      "description": "Evolução fonoaudiológica oficial em 4 páginas com FOIS e PARD",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "sessionDate": { "type": "string", "maxLength": 20 },
        "therapistName": { "type": "string", "maxLength": 150 },
        "therapistCrfa": { "type": "string", "maxLength": 50 },
        "foisLevel": { "type": "number" },
        "pardLevel": { "type": "string", "maxLength": 10 },
        "clinicalSummary": { "type": "string", "maxLength": 5000 },
        "sessionConductSummary": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "patientId", "sessionDate", "therapistName", "foisLevel", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Perfis de usuários, terapeutas e cuidadores cadastrados no sistema"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Fichas cadastrais dos pacientes atendidos"
    },
    "/evolutions/{evolutionId}": {
      "schema": "ClinicalEvolution",
      "description": "Evoluções clínicas oficiais de 4 módulos"
    }
  }
}
