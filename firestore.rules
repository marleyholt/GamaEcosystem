rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Permissões para todas as coleções clínicas do sistema GamaEcosystem
    // Permitir leitura e escrita para usuários autenticados, ou em fase de bootstrap inicial
    match /users/{userId} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /caregivers/{caregiverId} {
      allow read, write: if true;
    }

    match /therapists/{therapistId} {
      allow read, write: if true;
    }

    match /evolutions/{evolutionId} {
      allow read, write: if true;
    }

    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    match /daily_logs/{logId} {
      allow read, write: if true;
    }

    match /medical_records/{recordId} {
      allow read, write: if true;
    }

    match /clinic_config/{configId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
